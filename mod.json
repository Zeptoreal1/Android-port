{
  "geode": "5.11.2",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "prsevend.voidius",
  "name": "Voidius",
  "version": "v1.6.1",
  "developer": "alternate",
  "description": "Spam fast enough and it takes over, clicking at a steady rate you choose. Comes with an afterflow-style control panel.",
  "tags": [
    "cheat",
    "gameplay"
  ],
  "settings": {
    "general-title": {
      "type": "title",
      "name": "General"
    },
    "enabled": {
      "type": "bool",
      "name": "Enabled",
      "description": "Also the pill at the top of the panel, or the Toggle key.",
      "default": true
    },
    "toggle-key": {
      "type": "keybind",
      "name": "Toggle key",
      "description": "Turns the assist on or off from anywhere.",
      "default": "F7",
      "category": "gameplay",
      "platforms": [
        "win",
        "mac"
      ]
    },
    "panel-key": {
      "type": "keybind",
      "name": "Panel key",
      "description": "Opens or closes the control panel.",
      "default": "F5",
      "category": "universal",
      "platforms": [
        "win",
        "mac"
      ]
    },
    "replay-tutorial": {
      "type": "bool",
      "name": "Replay tutorial",
      "description": "Turn on to see the animated tour again the next time you open the panel.",
      "default": false
    },
    "show-cps": {
      "type": "bool",
      "name": "Show CPS",
      "description": "Your clicks per second in the bottom-left corner; turns green while the assist is spamming for you.",
      "default": true
    },
    "trigger-cps": {
      "type": "int",
      "name": "Trigger CPS",
      "description": "Spam at least this fast and the assist takes over. Stop spamming and you get control back.",
      "default": 8,
      "min": 3,
      "max": 30
    },
    "quick-start": {
      "type": "bool",
      "name": "Quick start",
      "description": "Kick in after 2 fast clicks instead of 3, so it reacts sooner when a spam part starts. Can trigger on fast double jumps.",
      "default": false
    },
    "rhythm-title": {
      "type": "title",
      "name": "Rhythm"
    },
    "go-straight": {
      "type": "bool",
      "name": "Go straight",
      "description": "Ship, wave, ufo and swing: hold the height you started spamming at, so you fly flat. The CPS below is the fastest it clicks. Turn off to spam at a fixed rhythm that can drift up or down.",
      "default": true
    },
    "rhythm": {
      "type": "string",
      "name": "Speed",
      "description": "fixed: spam at the speeds below. match your speed: spam at the rate you're clicking, just perfectly even.",
      "default": "fixed",
      "one-of": [
        "fixed",
        "match your speed"
      ]
    },
    "hold-percent": {
      "type": "int",
      "name": "Hold %",
      "description": "How much of each click is held down, when not going straight. Higher makes the ship climb more and the wave go up longer.",
      "default": 50,
      "min": 10,
      "max": 90
    },
    "cps-ship": {
      "type": "int",
      "name": "Ship CPS",
      "default": 20,
      "min": 2,
      "max": 60
    },
    "cps-wave": {
      "type": "int",
      "name": "Wave CPS",
      "default": 15,
      "min": 2,
      "max": 60
    },
    "cps-ufo": {
      "type": "int",
      "name": "UFO CPS",
      "default": 12,
      "min": 2,
      "max": 60
    },
    "cps-swing": {
      "type": "int",
      "name": "Swing CPS",
      "default": 12,
      "min": 2,
      "max": 60
    },
    "target-cps": {
      "type": "int",
      "name": "Other modes CPS",
      "description": "Cube, ball, robot and spider.",
      "default": 10,
      "min": 2,
      "max": 60
    },
    "modes-title": {
      "type": "title",
      "name": "Helps in"
    },
    "mode-ship": {
      "type": "bool",
      "name": "Ship",
      "default": true
    },
    "mode-wave": {
      "type": "bool",
      "name": "Wave",
      "default": true
    },
    "mode-ufo": {
      "type": "bool",
      "name": "UFO",
      "default": true
    },
    "mode-swing": {
      "type": "bool",
      "name": "Swing",
      "default": true
    },
    "mode-cube": {
      "type": "bool",
      "name": "Cube",
      "default": false
    },
    "mode-ball": {
      "type": "bool",
      "name": "Ball",
      "default": false
    },
    "mode-robot": {
      "type": "bool",
      "name": "Robot",
      "default": false
    },
    "mode-spider": {
      "type": "bool",
      "name": "Spider",
      "default": false
    },
    "ui-title": {
      "type": "title",
      "name": "Panel look"
    },
    "ui-primary-color": {
      "type": "color",
      "name": "Primary color",
      "default": "#A855F7"
    },
    "ui-secondary-color": {
      "type": "color",
      "name": "Secondary color",
      "default": "#D5B4FF"
    },
    "ui-surface-color": {
      "type": "color",
      "name": "Surface color",
      "default": "#17131F"
    },
    "ui-text-color": {
      "type": "color",
      "name": "Text color",
      "default": "#EFE7F7"
    },
    "ui-glow": {
      "type": "bool",
      "name": "Glow",
      "description": "Soft accent glow around the panel.",
      "default": true
    },
    "ui-panel-size": {
      "type": "int",
      "name": "Panel size %",
      "default": 100,
      "min": 60,
      "max": 140
    },
    "ui-text-size": {
      "type": "int",
      "name": "Text size %",
      "default": 100,
      "min": 80,
      "max": 140
    }
  },
  "resources": {
    "files": [
      "resources/afterflow-body.fnt",
      "resources/afterflow-body.png",
      "resources/afterflow-display.fnt",
      "resources/afterflow-display.png",
      "resources/OFL.txt"
    ]
  },
  "repository": "REPLACE_WITH_YOUR_REPO_URL"
}